{
  "expo": {
    "name": "FluxerHooks",
    "slug": "fluxerhooks",
    "version": "beta-0.0.17",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#16171B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.fluxerhooks"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4641D9"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "app.fluxerhooks",
      "versionCode": 17,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-background-task",
      [
        "expo-image-picker",
        {
          "photosPermission": "FluxerHooks accède à tes photos pour les joindre aux messages et choisir un fond d’écran.",
          "cameraPermission": "FluxerHooks utilise l’appareil photo pour prendre une image à joindre."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FluxerHooks utilise l’appareil photo pour scanner le QR code de connexion d’un appareil et pour prendre des images à joindre.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withScrollbar"
    ],
    "backgroundColor": "#16171B",
    "scheme": "fluxerhooks"
  }
}
